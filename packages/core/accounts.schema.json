{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": ["providerId", "id", "displayName"],
        "additionalProperties": false
      }
    },
    "defaultProviderId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "defaultAccounts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["version", "accounts", "defaultAccounts"],
  "additionalProperties": false
}
